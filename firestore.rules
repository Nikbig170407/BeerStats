// firestore.rules
//
// Zugriffsregeln.
//
// ACHTUNG, hier stand lange etwas Falsches: Die Rede war von Cloud
// Functions, die Statistiken und Ranglisten mit Admin-Rechten schreiben.
// Cloud Functions brauchen den Blaze-Tarif und gibt es in diesem Projekt
// nicht. Die Blöcke für `users/{id}/stats`, `games/{id}/statistics` und
// `leaderboards` stehen deshalb auf `write: false` und bewachen
// Sammlungen, in die niemand schreibt. Sie bleiben trotzdem stehen: Falls
// die Statistik je auf den Server wandert, ist es genau diese Regel.
//
// Was der Client tatsächlich schreibt, sind die Spieler-Profile unter
// `users/{uid}/players` – dort rechnet das iPhone die Zahlen am Spielende.
//
// Bei Spielen dürfen Clients `throws` nur ERSTELLEN, nie ändern oder
// löschen. Das hält den Append-Only-Log manipulationssicher.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // MARK: - users

    match /users/{userId} {
      // Nur der Besitzer. Vorher durfte jeder Angemeldete jedes
      // Nutzerdokument lesen – gedacht war das für die Freundessuche, die
      // aber gar nicht verlinkt ist. Damit lag unter anderem der
      // `fcmToken` jedes Nutzers für jeden lesbar herum, also eine
      // Gerätekennung ohne jeden Grund.
      //
      // Wird das Freundesystem aktiviert, braucht es hier KEIN pauschales
      // Lesen zurück, sondern eine öffentliche Teilmenge: Name und Bild in
      // einem eigenen Dokument, alles Übrige bleibt privat.
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      // `stats` darf NICHT vom Client geschrieben werden, auch nicht vom
      // Owner selbst – nur über eine Cloud Function. Wird über die
      // fehlende Erlaubnis für geänderte `stats`-Felder erzwungen.
      allow update: if isOwner(userId)
                    && request.resource.data.stats == resource.data.stats;
      allow delete: if false; // Löschung nur über Cloud Function (Kaskade)

      // Kanonische Lifetime-Statistik – ausschließlich lesbar für den Owner,
      // Schreibzugriff ausschließlich über Cloud Functions (Admin SDK).
      match /stats/{document=**} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Mitspieler-Profile ohne eigenes Konto, verwaltet vom Besitzer
      // dieses User-Dokuments (siehe PlayerProfile.swift).
      //
      // Anders als bei `stats` schreibt hier bewusst der Client: In dieser
      // Ausbaustufe rechnet das iPhone die Statistiken am Spielende, weil
      // Cloud Functions den kostenpflichtigen Blaze-Tarif voraussetzen.
      // Die Daten gehören ausschließlich dem Besitzer, ein fremder Zugriff
      // ist damit ohnehin ausgeschlossen. Sollen die Zahlen später
      // serverseitig fortgeschrieben werden, wird hier auf `write: false`
      // umgestellt.
      match /players/{profileId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Verhindert doppelte Usernamen: Erstellung nur, wenn die Dokument-ID
    // (= Username) noch nicht existiert; danach unveränderlich.
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // MARK: - friendships

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Nur der NICHT anfragende Teilnehmer darf den Status ändern
      // (annehmen/ablehnen) – verhindert, dass sich jemand selbst bestätigt.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.auth.uid != resource.data.requestedBy
                    && request.resource.data.participantIds == resource.data.participantIds
                    && request.resource.data.requestedBy == resource.data.requestedBy;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    // MARK: - games

    match /games/{gameId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.allPlayerIds || resource.data.isPublic == true);

      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.createdBy
                    && request.auth.uid in request.resource.data.allPlayerIds;

      // Teilnehmer dürfen den Live-Zustand aktualisieren (Ergebnis, Status,
      // Endzeitpunkt). Die Zugriffsliste und der Ersteller sind davon
      // ausgenommen: Sonst könnte ein Teilnehmer die anderen aussperren
      // oder Fremde hineinschreiben. Wichtig wird das, sobald tatsächlich
      // zwei Geräte an derselben Partie hängen.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.allPlayerIds
                    && request.resource.data.allPlayerIds == resource.data.allPlayerIds
                    && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if false;

      // Append-Only-Log: nur Erstellung erlaubt, niemals Änderung/Löschung.
      //
      // Das `get()` auf das Spiel kostet pro Prüfung einen Lesezugriff –
      // bei sechzig Würfen also sechzig zusätzliche. Im kostenlosen Tarif
      // ist das unkritisch, aber es ist der erste Ort, an dem es eng wird,
      // wenn die App je viele Partien gleichzeitig hat.
      match /throws/{throwId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.allPlayerIds;

        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.allPlayerIds;

        allow update, delete: if false;
      }

      // Einmalige Zusammenfassung nach Spielende – ausschließlich über
      // Cloud Function geschrieben.
      match /statistics/{document=**} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.allPlayerIds;
        allow write: if false;
      }
    }

    // MARK: - leaderboards

    // Ausschließlich von Cloud Functions geschrieben, für alle angemeldeten
    // Nutzer lesbar.
    match /leaderboards/{scope}/entries/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
